{
  "editor": {
    "view": {
      "view-store-zoom": false,
      "view-store-position": false,
      "view-show-grid": true,
      "view-snap-grid": false,
      "view-grid-size": "20",
      "view-node-status": true,
      "view-node-show-label": true,
      "view-show-tips": false,
      "view-show-welcome-tours": false,
      "view-node-info-icon": true
    },
    "tours": {
      "welcome": "5.0.8"
    },
    "keymap": {
      "core:deploy-flows": {
        "scope": "*",
        "key": "ctrl-s"
      },
      "core:clear-debug-messages": {
        "scope": "*",
        "key": "ctrl-shift-d"
      },
      "core:show-event-log": {
        "scope": "*",
        "key": "ctrl-alt-l"
      },
      "core:zoom-reset": {
        "scope": "red-ui-workspace",
        "key": "ctrl-1"
      },
      "core:zoom-out": {
        "scope": "red-ui-workspace",
        "key": "ctrl-§"
      },
      "core:zoom-in": {
        "scope": "red-ui-workspace",
        "key": "ctrl-2"
      },
      "core:show-export-dialog": {
        "scope": "red-ui-workspace",
        "key": "ctrl-e"
      }
    },
    "dialog": {
      "export": {
        "pretty": true,
        "json-view": true
      }
    },
    "sidebar": {
      "state": {
        "v": 4,
        "tabs": [],
        "primary": {
          "width": 750,
          "top": {
            "tabs": [
              "info",
              "help",
              "config",
              "context",
              "UnitTestingErlangRed",
              "Flow2Mermaid",
              "FlowHubDiff",
              "IntrospectionMsgTrace",
              "IntrospectionObfuscation",
              "IntrospectionLint",
              "IntrospectionCapture",
              "ScratchPad",
              "FlowCompare",
              "erlconfig",
              "sidebar-auto-layout",
              "FlowCompare"
            ],
            "height": 955,
            "hidden": false,
            "active": "config"
          },
          "bottom": {
            "tabs": [
              "debug"
            ],
            "hidden": false,
            "active": "debug"
          }
        },
        "secondary": {
          "width": 613,
          "top": {
            "tabs": [
              "explorer"
            ],
            "height": 739,
            "hidden": false,
            "active": "explorer"
          },
          "bottom": {
            "tabs": [
              "palette"
            ],
            "hidden": false,
            "active": "palette"
          }
        }
      }
    }
  },
  "debug": {
    "filter": "filterAll",
    "filteredNodes": []
  },
  "menu-menu-item-sidebar": true
}
